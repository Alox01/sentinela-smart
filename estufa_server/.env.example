# Copie este arquivo para .env no seu computador e preencha os valores reais.
# Nunca envie o arquivo .env real para o Git.

# Opcional: habilita persistencia em PostgreSQL/Supabase.
# Exemplo com Supabase pooler:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Opcional: chave exigida para comandos de controle da estufa.
# Se ficar vazio, o servidor aceita comandos sem chave.
# Se preencher, o app precisa usar a mesma chave no cadastro da estufa.
ESTUFA_API_TOKEN=

# Opcional: porta HTTP do servidor local.
PORT=3000

# Opcional: intervalo minimo para gravar leituras periodicas no banco.
# Padrao: 600000 ms, ou seja, 10 minutos.
PERSIST_READINGS_INTERVAL_MS=600000

# Modo "ESP32 virtual": faz este processo empurrar leituras por HTTP para um
# servidor de nuvem (POST /leitura), como o aparelho fisico fara. Deixe vazio
# para usar apenas o polling interno de hoje.
# Exemplo: PUSH_TARGET_URL=https://sua-estufa.onrender.com
PUSH_TARGET_URL=

# Opcional: intervalo entre os envios do ESP32 virtual. Padrao: 600000 ms.
PUSH_INTERVAL_MS=600000

# Opcional: token usado nos envios do ESP32 virtual. Se vazio, usa ESTUFA_API_TOKEN.
PUSH_TOKEN=

# Opcional: limita quais origens web podem chamar a API.
# Deixe vazio em testes locais simples.
# Exemplo: http://localhost:53312,http://192.168.1.11:53312
ALLOWED_ORIGINS=